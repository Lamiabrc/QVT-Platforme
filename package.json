{
  "name": "qvt-platform",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/qvtbox run dev",
    "build": "npm --workspace apps/qvtbox run build",
    "lint": "npm --workspace apps/qvtbox run lint",
    "typecheck": "npm --workspace apps/qvtbox run typecheck",
    "dev:qvtbox": "npm run dev",
    "build:qvtbox": "npm run build",
    "seed:demo": "npm --workspace apps/qvtbox run seed:demo"
  }
}
